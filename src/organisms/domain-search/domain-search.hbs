<div class="o-domain-search display-flex align-items-center background-snow u-p-3 u-m-x-0">
	<form action="{{action}}" class="o-domain-search__form" target="_top" method="{{method}}" role="search"{{#if novalidate}} novalidate{{/if}}>
		<div class="o-domain-search__form-wrapper wrapper display-flex u-p-x-0">
			<label for="{{input_id}}" class="u-visuallyhidden">{{label}}</label>
			<input
				type="search"
				class="o-domain-search__input js-search-domain-input"
				autocomplete="off"
				placeholder="{{placeholder}}"
				id="{{input_id}}"
				{{#if value}}value="{{value}}"{{/if}}>
			{{> @button el="button" button_type="submit" text=button_text modifiers="secondary o-domain-search__submit" id=button_id}}
		</div>
	</form>
</div>
